{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillstation.local/schemas/skill-hub.schema.json",
  "title": "Hub record of a skill (.meta/hub.yaml)",
  "description": "What the hub decides about a skill, in .meta/hub.yaml (hub layout 6 and later): status, content approval, sources, provenance and the dates the hub writes. The skill's id and collection are its folder; its name and description are in SKILL.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "archived"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed": {
          "type": "boolean"
        },
        "curated": {
          "type": "boolean"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "routing_review_rationale": {
          "type": "string",
          "minLength": 1
        },
        "content_reviewed_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillSource"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "revision": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "occurred_at"
        ],
        "properties": {
          "from": {
            "enum": [
              "draft",
              "active",
              "deprecated"
            ]
          },
          "state": {
            "enum": [
              "draft",
              "active",
              "deprecated",
              "archived"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content": {
      "type": "object"
    }
  },
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github",
            "git",
            "local"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)(/[a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$"
        },
        "folder_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "files_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "local"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "repository"
              ]
            }
          }
        }
      ]
    },
    "skillSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "roles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "upstream",
              "learning"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "github",
            "git",
            "local"
          ]
        },
        "repo": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "files_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "folder_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "transformations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "synced": {
          "type": "string"
        },
        "learn_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "added_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
